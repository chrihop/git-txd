{
  "name": "git-txd",
  "version": "0.1.0",
  "description": "Durable Git transactions for AI agents sharing one checkout",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "git-txd": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "contrib/systemd",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:package": "node scripts/test-package.mjs",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "format": "prettier --write src tests scripts docs README.md",
    "format:check": "prettier --check src tests scripts docs README.md",
    "prepack": "npm run build",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "commander": "15.0.0",
    "fs-ext": "2.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/fs-ext": "2.0.3",
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrihop/git-txd.git"
  },
  "homepage": "https://github.com/chrihop/git-txd#readme",
  "bugs": {
    "url": "https://github.com/chrihop/git-txd/issues"
  },
  "keywords": [
    "git",
    "ai-agents",
    "mcp",
    "cli",
    "transactions",
    "concurrency"
  ]
}
